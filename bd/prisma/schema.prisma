// Prisma schema — PostgreSQL only.
// NOTE (Prisma 7): the datasource `url` is configured in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  name          String?
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ─── Team site content (public reads, ADMIN-only writes) ────────────────────

model NewsPost {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  category    String   @default("Мэдээ")
  tags        String[] @default([])
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model Player {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  number       Int?
  role         String   @default("PLAYER") // PLAYER | COACH | STAFF
  position     String? // Хамгаалагч | Довтлогч | Төв | албан тушаал
  heightCm     Int?
  weightKg     Int?
  birthYear    Int?
  hometown     String?
  photo        String?
  actionPhoto  String?
  bio          String?
  academicYear String?
  isCaptain    Boolean  @default(false)
  ppg          Float?
  rpg          Float?
  apg          Float?
  sortOrder    Int      @default(0)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublic, sortOrder])
}

model Game {
  id            String   @id @default(uuid()) @db.Uuid
  competition   String   @default("Их сургуулиудын аварга шалгаруулах тэмцээн")
  round         String?
  opponent      String
  opponentShort String?
  opponentLogo  String?
  isHome        Boolean  @default(true)
  tipsAt        DateTime
  venue         String   @default("UFE Арена")
  status        String   @default("SCHEDULED") // SCHEDULED | FINAL | CANCELLED
  teamScore     Int?
  opponentScore Int?
  note          String?
  streamUrl     String?
  ticketUrl     String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, tipsAt])
}

model StandingRow {
  id        String   @id @default(uuid()) @db.Uuid
  teamName  String
  teamShort String?
  teamLogo  String?
  wins      Int      @default(0)
  losses    Int      @default(0)
  sortOrder Int      @default(0)
  isCurrent Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isCurrent, sortOrder])
}

model Partner {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  logo      String?
  url       String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, sortOrder])
}

model MediaAlbum {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  slug        String   @unique
  coverImage  String?
  images      Json     @default("[]") // [{ url, caption? }]
  eventDate   DateTime?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// Editable marketing copy, addressed by page/section (JSON blobs).
model SiteContent {
  id        String   @id @default(uuid()) @db.Uuid
  page      String
  section   String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, section])
}

// Public contact form inbox (admins read/mark/delete).
model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}
