// Prisma schema — MongoDB.
// IDs are ObjectIds; role/status-like fields are validated strings (the
// MongoDB connector has no native enums).

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // Ship the linux engine alongside the native one so the Vercel serverless
  // bundle always contains it (build-time `prisma generate` re-runs there,
  // but committed binaries keep the lambda self-sufficient).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  email         String           @unique
  // Unique among non-null values via a partial index created by the seed —
  // a plain @unique would allow only ONE user without a username.
  username      String?
  passwordHash  String
  name          String?
  role          String           @default("USER") // USER | ADMIN
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  refreshTokens RefreshToken[]
  contentBlocks ContentBlock[]
  contentEdits  ContentHistory[]
  media         Media[]

  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String    @map("user_id") @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// ─── Team site content (public reads, ADMIN-only writes) ────────────────────

model NewsPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  category    String   @default("Мэдээ")
  tags        String[] @default([])
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model Player {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String   @unique
  number        Int?
  role          String   @default("PLAYER") // PLAYER | COACH | STAFF
  position      String? // Хамгаалагч | Довтлогч | Төв | албан тушаал
  heightCm      Int?
  weightKg      Int?
  birthYear     Int?
  hometown      String?
  photo         String?
  actionPhoto   String?
  // Vertical framing of `photo` inside fixed-ratio slots, 0 (top) – 100
  // (bottom). Null keeps the default bottom-anchored look.
  photoPosition Int?
  // Rendered size of `photo` inside the slot, 40 (shrunken) – 150 (zoomed
  // in, clipped by the slot). Null/100 = natural contain-fit size.
  photoScale    Int?
  bio           String?
  academicYear  String?
  isCaptain     Boolean  @default(false)
  ppg           Float?
  rpg           Float?
  apg           Float?
  // Display-only roster-card extras (yearsOnTeam, major, motto, achievements…)
  // edited as JSON in the admin panel. See PlayerProfileExtras in fd/types.
  profile       Json?
  sortOrder     Int      @default(0)
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublic, sortOrder])
}

model Game {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  competition   String   @default("Их сургуулиудын аварга шалгаруулах тэмцээн")
  round         String?
  opponent      String
  opponentShort String?
  opponentLogo  String?
  isHome        Boolean  @default(true)
  tipsAt        DateTime
  venue         String   @default("UFE Арена")
  status        String   @default("SCHEDULED") // SCHEDULED | FINAL | CANCELLED
  teamScore     Int?
  opponentScore Int?
  note          String?
  streamUrl     String?
  ticketUrl     String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, tipsAt])
}

model LiveGame {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  gameId        String    @unique @db.ObjectId
  status        String    @default("NOT_STARTED") // NOT_STARTED | LIVE | HALFTIME | FINAL
  period        Int       @default(1)
  clockSeconds  Int       @default(720)
  clockRunning  Boolean   @default(false)
  teamScore     Int       @default(0)
  opponentScore Int       @default(0)
  teamFouls     Int[]     @default([])
  opponentFouls Int[]     @default([])
  timeouts      Int[]     @default([6, 6])
  lineup        String[]  @default([])
  startedAt     DateTime?
  endedAt       DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@index([gameId, status])
}

model LiveGameEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  gameId    String   @db.ObjectId
  type      String
  payload   Json
  reversed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
}

model StandingRow {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  teamName  String
  teamShort String?
  teamLogo  String?
  wins      Int      @default(0)
  losses    Int      @default(0)
  sortOrder Int      @default(0)
  isCurrent Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isCurrent, sortOrder])
}

model Partner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  logo      String?
  url       String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, sortOrder])
}

model MediaAlbum {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  category    String    @default("GAMES") // GAMES | COMMUNITY | EVENTS
  coverImage  String?
  images      Json      @default("[]") // [{ url, caption? }]
  eventDate   DateTime?
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, sortOrder])
  @@index([category, isPublished])
}

// Front office — executive profiles grouped by tab (ownership / basketball
// operations / business / coaches). The STAFF group powers the /staff page's
// team-staff cards (coaches, captain) with richer bio sections.
model Executive {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  group     String   @default("COACHES") // OWNERSHIP | OPERATIONS | BUSINESS | COACHES | STAFF
  title     String
  photo     String?
  bio       String?
  bullets   String[] @default([])
  // Optional bio-drawer detail sections: [{ heading, text?, list? }]
  sections  Json?
  sortOrder Int      @default(0)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublic, group, sortOrder])
}

// Video library — featured player + category chips on /videos.
model Video {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  category    String   @default("HIGHLIGHTS") // HIGHLIGHTS | INTERVIEWS | BEHIND_THE_SCENES | PRESS
  thumbnail   String?
  videoUrl    String? // direct mp4/hls source
  youtubeId   String? // YouTube fallback (iframe embed)
  durationSec Int?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, category, sortOrder])
}

// Fan club shop catalogue — product cards on /fan-club.
model ShopProduct {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String   @unique
  category       String   @default("JERSEYS") // JERSEYS | TEES | HOODIES | HATS | KIDS | GEAR
  price          Int // MNT
  compareAtPrice Int?
  image          String?
  url            String? // external product page
  sizes          String[] @default([])
  badge          String?
  isVisible      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isVisible, category, sortOrder])
}

// Shop orders (фэн клаб). Items are a JSON snapshot of the purchased
// products so history survives product edits/deletion.
model Order {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  customerName String
  phone        String
  email        String?
  note         String?
  items        Json     @default("[]") // [{ name, price, qty }]
  total        Int      @default(0) // MNT
  status       String   @default("NEW") // NEW | CONFIRMED | SHIPPED | DONE | CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

// Editable marketing copy, addressed by page/section (JSON blobs).
model SiteContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  page      String
  section   String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, section])
}

// Editable site text, one document per page/key/locale. New pages and keys
// appear without schema changes: the admin registers defaults (ensure) and
// edits values; every edit is written to ContentHistory so it can be reverted.
model ContentBlock {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  pageSlug  String           @map("page_slug")
  key       String
  locale    String
  type      String // text | richtext | json | image
  value     String
  updatedBy String?          @map("updated_by") @db.ObjectId
  updater   User?            @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  history   ContentHistory[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([pageSlug, key, locale])
  @@index([pageSlug, locale])
  @@map("content_blocks")
}

// Uploaded images. Binary assets live in the storage provider (Cloudinary);
// this collection keeps metadata + the provider's public_id so deleting a
// document also deletes the asset. Swapping providers means a new provider
// value + documents.
model Media {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  provider   String   @default("cloudinary")
  publicId   String   @unique @map("public_id")
  url        String
  mime       String
  sizeBytes  Int      @map("size_bytes")
  width      Int?
  height     Int?
  altText    String?  @map("alt_text")
  folder     String   @default("uploads")
  uploadedBy String?  @map("uploaded_by") @db.ObjectId
  uploader   User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([uploadedBy])
  @@map("media")
}

// Full audit trail of content edits: who changed what, when, from which value.
model ContentHistory {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  blockId   String       @map("block_id") @db.ObjectId
  block     ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  oldValue  String?      @map("old_value")
  newValue  String       @map("new_value")
  changedBy String?      @map("changed_by") @db.ObjectId
  changer   User?        @relation(fields: [changedBy], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([blockId, createdAt(sort: Desc)])
  @@map("content_history")
}
