# ─── Server ─────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# HTTP port (backend serves http://localhost:4000)
PORT=4000
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
# Dev database (docker-compose service `postgres`, port 5432)
DATABASE_URL=postgresql://ufeedu:ufeedu@localhost:5433/ufeedu_dev
# Separate database used by `npm run test:e2e` (docker-compose service `postgres-test`, port 5433)
TEST_DATABASE_URL=postgresql://ufeedu:ufeedu@localhost:5434/ufeedu_test

# ─── Auth ───────────────────────────────────────────────────────────────────
# JWT signing secrets — MUST be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-0123456789abcdef
# Access token TTL (jsonwebtoken format: e.g. 15m, 1h, 7d)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime in days (stored hashed in the RefreshToken table)
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor (4–15). 12 is a good production default.
BCRYPT_COST=12

# ─── Cookies ────────────────────────────────────────────────────────────────
# Optional cookie domain (leave empty for localhost)
COOKIE_DOMAIN=

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:3000

# ─── Rate limiting ──────────────────────────────────────────────────────────
# General API limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter limiter applied to auth routes (register/login/refresh)
AUTH_RATE_LIMIT_MAX=20

# ─── Seed accounts (npm run db:seed) ───────────────────────────────────────
ADMIN_EMAIL=admin@ufeedu.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Site Admin
DEMO_USER_EMAIL=demo@ufeedu.local
DEMO_USER_PASSWORD=Demo123!
