# ─── Server ─────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# HTTP port (backend serves http://localhost:4000)
PORT=4010
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
# Dev database (docker-compose service `postgres`, host port 5433)
DATABASE_URL=mongodb://ufeedu:ufeedu@localhost:27018/ufeedu_dev?authSource=admin&directConnection=true
# TLS to the database (true | false). Local docker Postgres needs false;
# hosted Postgres (Neon/Supabase/etc.) usually needs true.

# Separate database used by `npm run test:e2e` (docker-compose service `postgres-test`, host port 5434)
TEST_DATABASE_URL=mongodb://ufeedu:ufeedu@localhost:27019/ufeedu_test?authSource=admin&directConnection=true

# ─── Auth ───────────────────────────────────────────────────────────────────
# JWT signing secrets — MUST be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-0123456789abcdef
# Admin PIN login (POST /api/v1/user/auth/pin): 4–8 digits, or empty to DISABLE.
# Dev convenience only — the app refuses to start in production with 1234.
ADMIN_PIN_CODE=1234
# Access token TTL (jsonwebtoken format: e.g. 15m, 1h, 7d)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime in days (stored hashed in the RefreshToken table)
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor (4–15). 12 is a good production default.
BCRYPT_COST=12

# ─── Cookies ────────────────────────────────────────────────────────────────
# Optional cookie domain (leave empty for localhost)
COOKIE_DOMAIN=

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:3000

# ─── Rate limiting ──────────────────────────────────────────────────────────
# General API limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter limiter applied to auth routes (register/login/refresh)
AUTH_RATE_LIMIT_MAX=20
# Strictest limiter: admin PIN attempts (short codes are brute-forceable)
PIN_RATE_LIMIT_MAX=5

# ─── Media storage (Cloudinary) ──────────────────────────────────────────────
# STORAGE_PROVIDER selects the upload backend: 'cloudinary' or empty (media
# endpoints disabled — useful for content-only dev). Selecting cloudinary
# requires ALL four CLOUDINARY_* values or the app refuses to start.
# Where to find them: Cloudinary dashboard → Settings → API Keys
#   (or the Dashboard home shows Cloud name + API key + secret).
# The API secret is SERVER-ONLY: never in the frontend, git, or logs.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# All uploads are grouped under this folder in your Cloudinary account
CLOUDINARY_FOLDER=ufeedu
# Hard per-file upload limit in MB (also enforced by the DB and magic-byte checks)
MAX_UPLOAD_MB=8

# ─── Seed accounts (npm run db:seed) ───────────────────────────────────────
STAFF_PASSWORD=9876

